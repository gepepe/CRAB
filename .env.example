# Copy to .env (never commit .env) and fill in.
# Public URL used in the result e-mail sent to users
CRAB_BASE_URL=https://crab.bio.uniroma2.it
# SMTP account for result notifications (leave empty to disable e-mails)
CRAB_SMTP_USER=
CRAB_SMTP_PASSWORD=
# Path to RNAfold if not on PATH
RNAFOLD_BIN=RNAfold
