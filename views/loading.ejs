<!DOCTYPE html>
<html>
<head>
    <style>
        .loading-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 40px 30px;
            margin-top: 30px;
            margin-bottom: 30px;
        }
        .run-id-box {
            background-color: #f8f9fa;
            border-left: 4px solid #0d6efd;
            padding: 15px;
            border-radius: 0 8px 8px 0;
        }
        /* Animated Loading Logo (GIF) */
        .loading-gif {
            width: 100%;
            max-width: 170px;
            height: auto;
            display: block;
            margin: 0 auto;
        }
        /* Preformatted Progress Terminal Box */
        .progress-box {
            background-color: #212529;
            color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            font-family: 'Courier New', Courier, monospace;
            max-height: 300px;
            overflow-y: auto;
            text-align: left;
        }
    </style>
</head>
<body>

<div class='container text-center'>
    <%- include ("partials/header.ejs") %>
    
    <div class="loading-card mx-auto" style="max-width: 800px;">
        <img src="/images/loading.gif" alt="Processing animation" class="loading-gif mb-4">
        
        <h2 class="text-primary fw-bold mb-4">Processing...</h2>
        
        <div class="mb-4 text-start">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted small fw-bold">Completion percentage:</span>
                <span id="progress-percentage" class="text-primary small fw-bold">0%</span>
            </div>
            <div class="progress" style="height: 20px; border-radius: 10px;">
                <div id="dynamic-progress-bar" 
                     class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                     role="progressbar" 
                     style="width: 0%; transition: width 0.5s ease;" 
                     aria-valuenow="0" 
                     aria-valuemin="0" 
                     aria-valuemax="100">
                </div>
            </div>
        </div>
        
        <div class="run-id-box text-start mb-4">
            <h5 class="mb-1 text-secondary">Run ID</h5>
            <p class="mb-0 text-dark font-monospace fw-bold"><%= userID %></p>
        </div>

        <div class="mb-4">
            <h6 class="text-start text-secondary fw-bold text-uppercase tracking-wider small mb-2">Progress Status:</h6>
            <div class="progress-box">
                <pre id="progress-text-element" class="m-0" style="color: inherit; white-space: pre-wrap;"><%= progress %></pre>
            </div>
        </div>

        <hr class="my-4 text-muted">

        <div class="alert alert-info text-start d-flex align-items-center mb-0" role="alert">
            <div>
                <span class="fw-bold">Please note:</span> Save this URL or copy the Run ID to be able to retrieve your results in the future:<br>
                <a href='/waiting?uid=<%= userID %>' class="alert-link font-monospace small">/waiting?uid=<%= userID %></a>
            </div>
        </div>
    </div>

    <%- include ("partials/footer.ejs") %>

    <form action="/waiting" id="run_data" method="post" enctype="multipart/form-data">
        <input type="hidden" name="uid" value="<%= userID %>">
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const preElement = document.getElementById("progress-text-element");
        const progressBar = document.getElementById("dynamic-progress-bar");
        const progressPercentage = document.getElementById("progress-percentage");

        // Flag to prevent infinite loop during replacement
        let isReplacing = false;

        function updateProgressBar() {
            if (isReplacing) return;

            let text = preElement.innerText || preElement.textContent;
            let textChanged = false;
            
            // 1. Replace "---> done" with a green checkmark
            if (text.includes("---> done")) {
                text = text.replace(/---> done/g, "  ✅");
                textChanged = true;
            }

            // 2. Replace "str search" with explicit description
            if (text.includes("str search")) {
                text = text.replace(/str search/g, "🔍 Searching for Structural Motifs (RNA structure matching)...");
                textChanged = true;
            }

            // 3. Replace "nuc search" with explicit description
            if (text.includes("nuc search")) {
                text = text.replace(/nuc search/g, "🔍 Searching for Sequence Motifs (Nucleotide sequence matching)...");
                textChanged = true;
            }

            // If we modified the text, update the DOM safely
            if (textChanged) {
                isReplacing = true;
                preElement.innerText = text;
                isReplacing = false;
            }

            // Now, split by the rewritten term to calculate progress correctly
            const phases = text.split("Searching for Sequence Motifs");
            
            // Phase 1: Search for all (X / Y) matches in the structural part
            const strMatches = [...phases[0].matchAll(/\((\d+)\s*\/\s*(\d+)\)/g)];
            
            if (strMatches.length > 0) {
                const lastStrMatch = strMatches[strMatches.length - 1];
                const strCurrent = parseInt(lastStrMatch[1], 10);
                const strTotal = parseInt(lastStrMatch[2], 10);
                
                let finalCurrent = strCurrent;
                let finalTotal = strTotal;
                
                // Phase 2: Check if we entered sequence search
                if (phases.length > 1) {
                    const nucMatches = [...phases[1].matchAll(/\((\d+)\s*\/\s*(\d+)\)/g)];
                    
                    if (nucMatches.length > 0) {
                        const lastNucMatch = nucMatches[nucMatches.length - 1];
                        const nucCurrent = parseInt(lastNucMatch[1], 10);
                        const nucTotal = parseInt(lastNucMatch[2], 10);
                        
                        finalTotal = strTotal + nucTotal;
                        finalCurrent = strTotal + nucCurrent;
                    } else {
                        finalTotal = strTotal * 2;
                        finalCurrent = strTotal;
                    }
                } else {
                    finalTotal = strTotal * 2;
                }
                
                // Final percentage calculation
                if (finalTotal > 0) {
                    const percentage = Math.round((finalCurrent / finalTotal) * 100);
                    
                    // Update DOM standard states
                    progressBar.style.width = percentage + "%";
                    progressBar.setAttribute("aria-valuenow", percentage);
                    progressPercentage.innerText = percentage + "%";
                    
                    // --- Handle 100% Completion / Results Generation UI State ---
                    if (percentage === 100) {
                        const heading = document.querySelector(".loading-card h2");
                        if (heading) {
                            heading.innerText = "Generating your results...";
                            heading.classList.remove("text-primary");
                            heading.classList.add("text-success");
                        }
                        
                        progressBar.classList.remove("bg-primary");
                        progressBar.classList.add("bg-success");
                        
                        const label = document.querySelector(".loading-card .text-muted.small.fw-bold");
                        if (label) {
                            label.innerText = "Status:";
                        }
                        progressPercentage.innerText = "Finalizing report...";
                        progressPercentage.classList.remove("text-primary");
                        progressPercentage.classList.add("text-success");
                    }
                }
            }
        }

        // Run once at load
        updateProgressBar();

        // Observe the <pre> tag for real-time mutations
        const observer = new MutationObserver(updateProgressBar);
        observer.observe(preElement, { childList: true, characterData: true, subtree: true });
    });
</script>

</body>
<script src="/js/loading.js"></script>
</html>
