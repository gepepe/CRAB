<!DOCTYPE html>
<html>
<head>
    <style>
        /* Piccole rifiniture ad hoc se non presenti nel tuo CSS principale */
        body {
            background-color: #f8fafc !important; /* Sfondo generale ultra-pulito */
            color: #1e293b;
        }
        .hero-title {
            font-size: 1.25rem;
            font-weight: 500;
            line-height: 1.6;
            color: #334155;
        }
        .hero-brio {
            color: #2563eb;
            font-weight: 700;
        }
        .custom-card {
            background: #ffffff;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border-radius: 12px !important;
            padding: 1.75rem !important;
            height: 100%;
        }
        .card-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 1.25rem;
        }
        .divider-or {
            display: flex;
            align-items: center;
            text-align: center;
            color: #94a3b8;
            font-weight: 600;
            margin: 1.5rem 0;
        }
        .divider-or::before, .divider-or::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e2e8f0;
        }
        .divider-or:not(:empty)::before { margin-right: .75rem; }
        .divider-or:not(:empty)::after { margin-left: .75rem; }
        
        /* Fix estetica link dentro i bottoni di esempio */
        .btn-sample-link {
            text-decoration: none !important;
            color: #475569 !important;
        }
        .btn-sample-link:hover {
            color: #1e293b !important;
        }
    </style>
</head>

<body>
<%- include ("partials/header.ejs") %>

<div class='container my-5'>
    
    <div class="text-center mx-auto mb-5" style="max-width: 800px;">
        <h1 class="hero-title">
            <span class="hero-brio">CRAB</span> (Comprehensive Rna Analysis of binding-motifs) provides a comprehensive framework for identifying enriched sequence and structural motifs in RNA sequences, helping researchers predict and characterize RNA-protein interaction sites.
        </h1>
    </div>

    <div class="form-header p-3">
        <% if (Object.keys(errors).length !== 0)  { %>
            <h3 class="errors-heading text-danger">Please correct the following problems:</h3>
            <ul class="errors-list">
                <% Object.values(errors).forEach(error => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>
    </div>

    <% if (Object.keys(errors).length !== 0 && (!errors.email || Object.keys(errors).length > 1)) { %>
        <div class='container mb-4'>
            <% if (inputRNA_processed.error_message_str !== '') { %>
                <div class="alert alert-danger">
                    <h3>Input problems:</h3>
                    <%= inputRNA_processed.error_message_str %>
                </div>
            <% } %>
            <% if (inputBackground_processed.error_message_str !== '') { %>
                <div class="alert alert-danger mt-2">
                    <h3>Background problems:</h3>
                    <%= inputBackground_processed.error_message_str %>
                </div>
            <% } %>
        </div>
    <% } %>

    <section class='input-form'>
        <form method="post" action="/go/fileInput" novalidate enctype="multipart/form-data">
            
            <div class="row match-height">
                <div class="col-md-6 mb-4">
                    <fieldset class='custom-card'>
                        <div class="d-flex align-items-center mb-3">
                            <h3 class='card-title mb-0 mr-2'>Paste RNAs</h3>
                            <button title="Format" id="format_pop_1" type="button" class="btn btn-link p-0 text-muted" data-container="body" data-toggle="popover">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-question-circle-fill" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.496 6.033a.237.237 0 0 1-.24-.247C5.35 4.091 6.737 3.5 8.005 3.5c1.396 0 2.672.73 2.672 2.24 0 1.08-.635 1.594-1.244 2.057-.737.559-1.01.768-1.01 1.486v.105a.25.25 0 0 1-.25.25h-.81a.25.25 0 0 1-.25-.246l-.004-.217c-.038-.927.495-1.498 1.168-1.987.59-.444.965-.736.965-1.371 0-.825-.628-1.168-1.314-1.168-.803 0-1.253.478-1.342 1.134-.018.137-.128.25-.266.25h-.825zm2.325 6.443c-.584 0-1.009-.394-1.009-.927 0-.552.425-.94 1.01-.94.609 0 1.028.388 1.028.94 0 .533-.42.927-1.029.927z"/>
                                </svg>
                            </button>
                        </div>

                        <div class="form-group mb-3 <%= errors.message ? 'form-field-invalid' : '' %>">
                            <label for="inputRNA" class="text-secondary font-weight-bold small">INPUT RNA</label>
                            <textarea class="form-control seq-text-area style-textarea" rows="6" id="inputRNA" name="inputRNA" placeholder="Paste your RNA sequences here..." style="font-family: monospace; border-radius: 8px;" autofocus><%= inputRNA %></textarea>
                            
                            <div class="mt-3">
                                <input type="button" value="Input Example 1" id="ex_wo_str" class="btn btn-outline-secondary btn-sm mr-1 mb-1">
                                <input type="button" value="Input Example 2" id="ex_w_str" class="btn btn-outline-secondary btn-sm mr-1 mb-1">
                            </div>

                            <% if (errors.message) { %>
                                <div class="text-danger small mt-1"><%= errors.message.msg %></div>
                            <% } %>

                            <div class="mt-2 border-top pt-2">
                                <span class="text-muted d-block small mb-1">Precomputed runs:</span>
                                <a class="btn btn-light btn-sm btn-sample-link mr-1 mb-1" href="/waiting?uid=03567902e9645d1cd6fa0913549ddaba">Example 1</a>
                                <a class="btn btn-light btn-sm btn-sample-link mb-1" href="/waiting?uid=df50fb05c448aa9e5265cd09795d94b1">Example 2</a>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <div class="col-md-6 mb-4">
                    <fieldset class='custom-card'>
                        <h3 class='card-title'>Or upload your RNAs</h3>
                        
                        <div class="form-group <%= errors.message ? 'form-field-invalid' : '' %>">
                            
                            <div class="mb-4">
                                <label for="fileRNA" class="font-weight-bold text-secondary small mb-1">INPUT FILE (multiFASTA w/ or w/o dot-bracket)</label>
                                <input type="file" class="form-control-file p-2 border rounded bg-light" id="fileRNA" name="fileRNA" style="border-radius: 8px;"/>
                                <% if (errors.message) { %>
                                    <div class="text-danger small mt-1"><%= errors.message.msg %></div>
                                <% } %>
                            </div>

                            <div class="divider-or">OR</div>

                            <div>
                                <label for="fileBackground" class="font-weight-bold text-secondary small mb-1">BACKGROUND FILE (multiFASTA, optional)</label>
                                <input type="file" class="form-control-file p-2 border rounded bg-light" id="fileBackground" name="fileBackground" style="border-radius: 8px;">
                                <% if (errors.message) { %>
                                    <div class="text-danger small mt-1"><%= errors.message.msg %></div>
                                <% } %>
                            </div>

                        </div>
                    </fieldset>
                </div>
            </div>

            <fieldset class='custom-card mt-2 p-4'>
                <h3 class="card-title" style="font-size: 1.15rem;">Select species and type of experiments:</h3>

                <div class="row mt-3">
                    <div class="col-md-6 mb-3">
                        <label class="text-secondary font-weight-bold small">SPECIES</label>
                        <select data-placeholder="Select species (hg19, mm9)" multiple class="chosen-select form-control" name="options_species">
                            <option selected value='human'>Human (hg19-hg38)</option>
                            <option value='mouse'>Mouse (mm9-mm10-GRCm39)</option>
                            <option value='drosophila'>Drosophila (dm6)</option>
                            <option value='zebrafish'>Zebrafish (zv9-dr10-danRer11)</option>
                            <option value='elegans'>Elegans (ce11)</option>
                            <option value='arabidopsis'>Arabidopsis (tair10)</option>
                            <option value='yeast'>Yeast (sacCer3)</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-secondary font-weight-bold small">CLIP EXPERIMENTS</label>
                        <select data-placeholder="Select experiments (PAR-CLIP, eCLIP, HITS)" multiple class="chosen-select form-control" name="options_experiments" id="options_experiments">
                            <option value="__all__">Select all CLIP experiments</option>
                            <option selected value='global'>Global</option>
                            <option value='eCLIP'>eCLIP</option>
                            <option value='HITS-CLIP'>HITS-CLIP</option>
                            <option value='PAR-CLIP'>PAR-CLIP</option>
                            <option value='iCLIP'>iCLIP</option>
                            <option value='CLIP-seq'>CLIP-seq</option>
                            <option value='iCLAP'>iCLAP</option>
                            <option value='4SU-iCLIP'>4SU-iCLIP</option>
                            <option value='PIP-seq'>PIP-seq</option>
                            <option value='urea-iCLIP'>urea-iCLIP</option>
                            <option value='BrdU-CLIP'>BrdU-CLIP</option>
                            <option value='Fr-CLIP'>Fr-CLIP</option>
                        </select>
                    </div>
                </div>

                <div class="form-group mt-3 <%= errors.email ? 'form-field-invalid' : '' %>">
                    <label for="email" class="text-secondary font-weight-bold small">EMAIL (OPTIONAL)</label>
                    <input class="form-control" placeholder="Enter your email here" id="email" name="email" type="email" value="<%= email %>" style="border-radius: 8px; max-width: 400px;"/>
                    <% if (errors.email) { %>
                        <div class="text-danger small mt-1"><%= errors.email.msg %></div>
                    <% } %>
                </div>

                <div class="form-actions text-right mt-4 border-top pt-3">
                    <button class="btn btn-primary px-5 py-2 font-weight-bold shadow-sm" type="submit" style="border-radius: 8px; background-color: #2563eb; border-color: #2563eb; font-size: 1.05rem;">
                        Run Analysis &rarr;
                    </button>
                </div>
            </fieldset>

        </form>
    </section>
</div>

<%- include ("partials/footer.ejs") %>
</body>

<script type="text/javascript" src="/js/landing.js"></script>
</html>
